#!/bin/bash
# Srcipts - Unified launcher for Python automation scripts with uv

set -e

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$SCRIPT_DIR/src"

# Script-to-dependency mapping
declare -A SCRIPT_EXTRAS=(
    [pixcomp]="pixcomp"
    [cupixcomp]="cupixcomp"
    [vid2gif]="vid2gif"
    [pdf2xls]="pdf2xls"
    [downloader]="downloader"
)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print usage information
usage() {
    cat << EOF
Usage: srcipts <script-name> [arguments...]

Available scripts:
  pixcomp      - Compress images using PIL
  cupixcomp    - CUDA-accelerated image compression
  vid2gif      - Convert video files to animated GIFs
  pdf2xls      - Convert PDF documents to Excel/Markdown
  downloader   - Download videos from YouTube

Options:
  --help, -h   - Show this help message
  --list, -l   - List all available scripts

Examples:
  srcipts pixcomp ./photos ./compressed
  srcipts vid2gif -input video.mp4 -output output.gif
  srcipts downloader -url "https://youtube.com/..." -output ~/Downloads

For script-specific help, run the script with --help:
  srcipts pixcomp --help
EOF
}

# List available scripts
list_scripts() {
    echo "Available scripts:"
    for script in "${!SCRIPT_EXTRAS[@]}"; do
        echo "  - $script"
    done
}

# Main execution
main() {
    # Check if uv is installed
    if ! command -v uv &> /dev/null; then
        echo -e "${RED}Error: 'uv' command not found.${NC}"
        echo "Please install uv:"
        echo "  curl -LsSf https://astral.sh/uv/install.sh | sh"
        exit 1
    fi

    # Handle help and list commands
    case "${1:-}" in
        --help|-h|help)
            usage
            exit 0
            ;;
        --list|-l|list)
            list_scripts
            exit 0
            ;;
        "")
            usage
            exit 1
            ;;
    esac

    local script_name="$1"
    shift

    # Validate script name
    if [[ -z "${SCRIPT_EXTRAS[$script_name]}" ]]; then
        echo -e "${RED}Error: Unknown script '$script_name'${NC}"
        echo ""
        list_scripts
        exit 1
    fi

    local script_file="$SRC_DIR/$script_name.py"
    local extras="${SCRIPT_EXTRAS[$script_name]}"

    # Check if script file exists
    if [[ ! -f "$script_file" ]]; then
        echo -e "${RED}Error: Script file not found: $script_file${NC}"
        exit 1
    fi

    # Run the script with uv
    echo -e "${YELLOW}Running $script_name...${NC}" >&2
    uv run --extra "$extras" "$script_file" "$@"
}

# Execute main function
main "$@"
